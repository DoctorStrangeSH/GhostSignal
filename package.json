{
  "name": "ghost-signal",
  "version": "1.0.0",
  "description": "Ghost Signal — детективный терминал. Раскрывайте нераскрытые дела сквозь цифровые помехи.",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=3000 --no-browser",
    "build": "npm run check && npm run validate:data && npm test",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "validate:data": "node scripts/validate-game-data.mjs"
  },
  "keywords": [
    "detective",
    "noir",
    "mystery",
    "interactive",
    "game",
    "bootstrap"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
